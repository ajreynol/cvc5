(include "../programs/BitVectors.eo")

(include "../programs/PolyNorm.eo")
(include "../programs/Bitblasting.eo")
(include "../programs/Nary.eo")


;;;;; ProofRewriteRule::BV_REPEAT_ELIM

; rule: bv-repeat-elim
; implements: ProofRewriteRule::BV_REPEAT_ELIM
; args:
; - eq Bool: The equality to prove with this rule.
; requires: b is the concatenation of a, n times.
; conclusion: the equality between a and b.
(declare-rule bv-repeat-elim ((k1 Int) (k2 Int) (n Int) (a (BitVec k1)) (b (BitVec k2)))
  :args ((= (repeat n a) b))
  :requires (((eo::list_singleton_elim concat ($bv_unfold_repeat n a)) b))
  :conclusion (= (repeat n a) b)
)

;;;;; ProofRewriteRule::BV_SMULO_ELIM

; program: $bv_smulo_elim_rec
; args:
; - xa (BitVec n): An xor term involving the first argument to bvsmulo
; - xb (BitVec n): An xor term involving the second argument to bvsmulo
; - ppc (BitVec 1): An intermediate bitvector term accumulated to help construct the result.
; - res (BitVec 1): The current accumulated result.
; - ns (@TList Int): The list of bits to process.
; - nm2 Int: The bitwidth of a and b minus 2.
; return: >
;   A portion of the result of eliminating (bvsmulo a b).
(program $bv_smulo_elim_rec
  ((n Int) (xa (BitVec n)) (xb (BitVec n)) (ppc (BitVec 1)) (res (BitVec 1))
   (i Int) (nm2 Int) (ns (@TList Int) :list))
  :signature ((BitVec n) (BitVec n) (BitVec 1) (BitVec 1) (@TList Int) Int) (BitVec 1)
  (
  (($bv_smulo_elim_rec xa xb ppc res (@tlist.nil Int) nm2)   res)
  (($bv_smulo_elim_rec xa xb ppc res (@tlist i ns) nm2)
      (eo::define ((ia (eo::add nm2 (eo::neg i))))
      (eo::define ((ip1 (eo::add i 1)))
      (eo::define ((ppcn (bvor ppc (extract ia ia xa))))
        ($bv_smulo_elim_rec xa xb ppcn (bvor res (bvand (extract ip1 ip1 xb) ppcn)) ns nm2)))))
  )
)

; define: $bv_smulo_elim
; args:
; - a (BitVec n): The first argument to bvsmulo
; - b (BitVec n): The second argument to bvsmulo
; return: >
;   The result of eliminating (bvsmulo a b).
(define $bv_smulo_elim ((n Int :implicit) (a (BitVec n)) (b (BitVec n)))
  (eo::define ((w ($bv_bitwidth (eo::typeof a))))
  (eo::define ((wm1 (eo::add w -1)))
  (eo::define ((one (eo::to_bin 1 1)))
  (eo::ite (eo::eq w 1)
    (= (bvand a b) one)
    (eo::define ((mul (bvmul (sign_extend 1 a) (sign_extend 1 b))))
    (eo::ite (eo::eq w 2)
      (= (bvxor (extract w w mul) (extract wm1 wm1 mul)) one)
      (eo::define ((xa (bvxor a (sign_extend wm1 (extract wm1 wm1 a)))))
      (eo::define ((xb (bvxor b (sign_extend wm1 (extract wm1 wm1 b)))))
      (eo::define ((wm2 (eo::add w -2)))
      (eo::define ((ppc (extract wm2 wm2 xa)))
      (eo::define ((res ($bv_smulo_elim_rec xa xb ppc (bvand (extract 1 1 xb) ppc) ($iota2 1 (eo::add -1 wm2)) wm2)))
        (= (bvor res (bvxor (extract w w mul) (extract wm1 wm1 mul))) one)))))))))))))

; rule: bv-smulo-elim
; implements: ProofRewriteRule::BV_SMULO_ELIM
; args:
; - eq Bool: The equality to prove with this rule.
; requires: c is the result of eliminating the left hand side.
; conclusion: the given equality.
(declare-rule bv-smulo-elim ((n Int) (a (BitVec n)) (b (BitVec n)) (c Bool))
  :args ((= (bvsmulo a b) c))
  :requires ((($bv_smulo_elim a b) c))
  :conclusion (= (bvsmulo a b) c)
)

;;;;; ProofRewriteRule::BV_UMULO_ELIM

; program: $bv_umulo_elim_rec
; args:
; - a (BitVec n): The first argument to bvumulo.
; - b (BitVec n): The second argument to bvumulo.
; - uppc (BitVec 1): An intermediate bitvector term accumulated to help construct the result.
; - res (BitVec 1): The current accumulated result.
; - ns (@TList Int): The list of bits to process.
; - n Int: The bitwidth of a and b.
; return: >
;   A portion of the result of eliminating (bvumulo a b).
(program $bv_umulo_elim_rec
  ((n Int) (a (BitVec n)) (b (BitVec n))
   (uppc (BitVec 1)) (res (BitVec 1)) (i Int) (ns (@TList Int) :list))
  :signature ((BitVec n) (BitVec n) (BitVec 1) (BitVec 1) (@TList Int) Int) (BitVec 1)
  (
  (($bv_umulo_elim_rec a b uppc res (@tlist.nil Int) n)   res)
  (($bv_umulo_elim_rec a b uppc res (@tlist i ns) n)
      (eo::define ((ia (eo::add n -1 (eo::neg i))))
      (eo::define ((ip1 (eo::add i 1)))
      (eo::define ((uppcn (bvor (extract ia ia a) uppc)))
        (_ bvor (bvand (extract i i b) uppc) ($bv_umulo_elim_rec a b uppcn res ns n))))))
  )
)

; define: $bv_umulo_elim
; args:
; - a (BitVec n): The first argument to bvumulo
; - b (BitVec n): The second argument to bvumulo
; return: >
;   The result of eliminating (bvumulo a b).
(define $bv_umulo_elim ((n Int :implicit) (a (BitVec n)) (b (BitVec n)))
  (eo::define ((w ($bv_bitwidth (eo::typeof a))))
  (eo::ite (eo::eq w 1)
    false
    (eo::define ((wm1 (eo::add w -1)))
    (eo::define ((zero (eo::to_bin 1 0)))
    (eo::define ((uppc (extract wm1 wm1 a)))
    (eo::define ((mul (bvmul (concat zero a) (concat zero b))))
    (eo::define ((res ($bv_umulo_elim_rec a b uppc (bvor (extract w w mul))
                        ($iota2 1 (eo::add w -1)) w)))
      (= res (eo::to_bin 1 1))))))))))

; rule: bv-umulo-elim
; implements: ProofRewriteRule::BV_UMULO_ELIM
; args:
; - eq Bool: The equality to prove with this rule.
; requires: c is the result of eliminating the left hand side.
; conclusion: the given equality.
(declare-rule bv-umulo-elim ((n Int) (a (BitVec n)) (b (BitVec n)) (c Bool))
  :args ((= (bvumulo a b) c))
  :requires ((($bv_umulo_elim a b) c))
  :conclusion (= (bvumulo a b) c)
)

;;;;; ProofRewriteRule::BV_BITWISE_SLICING

; program: $bv_mk_bitwise_slicing_rec
; args:
; - f (-> (BitVec n) (BitVec n) (BitVec n)): The function we are applying bitwise slicing to.
; - c (BitVec n): The bitvector constant we are basing the slicing on.
; - a (BitVec n): The non-constant porition that is being sliced.
; - b (BitVec m): The bitlist representation of c that we have yet to process.
; - bit Bool: The value of the last bit we saw.
; - start Int: The start index from which all bits from c we processed each had the same value as bit.
; - end Int: The end index, which is the current bit of c we are processing.
; return: >
;   The result of the bitwise slicing. For example this program will return
;   (concat (bvand ((_ extract 3 2) #b0011) ((_ extract 3 2) x))
;           (bvand ((_ extract 1 0) #b0011) ((_ extract 1 0) x)))
;   given input where f is bvand, c is #b0011, and a is x.
(program $bv_mk_bitwise_slicing_rec ((n Int) (m Int) (k Int)
   (f (-> (BitVec n) (BitVec n) (BitVec n))) (a (BitVec n)) (c (BitVec n))
   (b Bool) (bn Bool) (bs (BitVec m) :list) (start Int) (end Int))
  :signature ((-> (BitVec n) (BitVec n) (BitVec n)) (BitVec k) (BitVec k) (BitVec m) Bool Int Int) (BitVec k)
  (
  (($bv_mk_bitwise_slicing_rec f c a @bv_empty bn start end)
      (_ concat ($nary_app f (extract start 0 c) (extract start 0 a)) @bv_empty))
  (($bv_mk_bitwise_slicing_rec f c a (@from_bools b bs) bn start end)
        (eo::define ((em1 (eo::add end -1)) (ep1 (eo::add end 1)))
        (eo::ite (eo::eq b bn)
          ($bv_mk_bitwise_slicing_rec f c a bs b start em1)
          (_ concat
            ($nary_app f (extract start ep1 c) (extract start ep1 a))
            ($bv_mk_bitwise_slicing_rec f c a bs b end em1)))))
  )
)

; define: $bv_is_bitwise_slicing_op
; args:
; - f : (-> (BitVec n) (BitVec n) (BitVec n)). The function to inspect.
; return: >
;   true if we can apply bitwise slicing to f. This is the case if f
;   is either bvand, bvor, or bvxor.
(define $bv_is_bitwise_slicing_op ((n Int :implicit) (f (-> (BitVec n) (BitVec n) (BitVec n))))
  (eo::or (eo::eq f bvand) (eo::eq f bvor) (eo::eq f bvxor)))

; program: $bv_mk_bitwise_slicing
; args:
; - a (BitVec n): The term to apply bitwise slicing to.
; return: >
;   The result of applying bitwise slicing to a. For example, given
;   (bvand x #b0011) as a, this program will return
;   (concat (bvand ((_ extract 3 2) #b0011) ((_ extract 3 2) x))
;           (bvand ((_ extract 1 0) #b0011) ((_ extract 1 0) x))).
(program $bv_mk_bitwise_slicing ((n Int) (m Int) (f (-> (BitVec m) (BitVec m) (BitVec m))) (a1 (BitVec n)) (a2 (BitVec n) :list))
  :signature ((BitVec n)) (BitVec n)
  (
  (($bv_mk_bitwise_slicing (f a1 a2))
              (eo::list_singleton_elim concat
                (eo::define ((c ($bv_get_first_const_child (f a1 a2))))
                (eo::requires ($bv_is_bitwise_slicing_op f) true
                (eo::define ((wm1 (eo::add (eo::len c) -1)))
                ($bv_mk_bitwise_slicing_rec
                  f
                  c
                  (eo::define ((nil (eo::nil f (eo::typeof a1))))
                    (eo::list_singleton_elim f (eo::list_erase f (f a1 a2) c))) ; remove the constant and recollect
                  (eo::list_rev @from_bools ($bv_mk_bitblast_step_const c))   ; convert the constant to a bitlist
                  ($bv_bit_set c wm1) wm1 wm1))))))
  )
)

; rule: bv-bitwise-slicing
; implements: ProofRewriteRule::BV_BITWISE_SLICING
; args:
; - eq Bool: The equality to prove with this rule.
; requires: We require that applying $bv_mk_bitwise_slicing to a gives b.
; conclusion: the equality between a and b.
(declare-rule bv-bitwise-slicing
  ((n Int) (a (BitVec n)) (b (BitVec n)))
  :args ((= a b))
  :requires ((($bv_mk_bitwise_slicing a) b))
  :conclusion (= a b)
)

;;;;; ProofRule::BV_BITBLAST_STEP

; rule: bv_bitblast_step
; implements: ProofRule::BV_BITBLAST_STEP.
; args:
; - eq Bool: The equality to prove.
; requires: >
;   We require that $bv_mk_bitblast_step applied to the left hand side returns
;   the right hand side. Note that a and b are either Booleans or bitvectors.
; conclusion: The given equality.
; note: >
;   The current implementation only covers some of the operators that may
;   appear in ProofRule::BV_BITBLAST_STEP.
(declare-rule bv_bitblast_step ((U Type) (a U) (b U))
  :args ((= a b))
  :requires ((($bv_mk_bitblast_step a) b))
  :conclusion (= a b)
)

;;;;; ProofRule::BV_POLY_NORM

; rule: bv_poly_norm
; implements: ProofRule::BV_POLY_NORM
; args:
; - a (BitVec n): The left-hand side of the equality.
; - b (BitVec n): The right-hand side of the equality.
; requires: >
;   That the bitvector terms a and b are equal up to polynomial normalization.
; conclusion: The given equality.
(declare-rule bv_poly_norm ((n Int) (a (BitVec n)) (b (BitVec n)))
  :args ((= a b))
  :requires (((eo::define ((w ($arith_eval_int_pow_2 ($bv_bitwidth (eo::typeof a)))))
                (eo::eq ($get_bv_poly_norm w a) ($get_bv_poly_norm w b))) true))
  :conclusion (= a b)
)

;;;;; ProofRule::BV_POLY_NORM_EQ

; rule: bv_poly_norm_eq
; implements: ProofRule::BV_POLY_NORM_EQ
; premises:
; - eq Bool: >
;   An equality stating that terms t and s of the form (bvmul cx (bvsub x1 x2))
;   and (bvmul cy (bvsub y1 y2)) are equal.
; args:
; - eqr Bool: The equivalence between equalities, proven by this rule.
; requires: >
;   The constants cx and cy are odd.
; conclusion: >
;   An equivalence between equalities specified by eqr and justified by eq.
(declare-rule bv_poly_norm_eq ((n Int) (cx (BitVec n)) (xb1 (BitVec n)) (xb2 (BitVec n))
                               (cy (BitVec n)) (yb1 (BitVec n)) (yb2 (BitVec n)) (one (BitVec n) :list))
  :premises ((= (bvmul cx (bvsub xb1 xb2) one) (bvmul cy (bvsub yb1 yb2) one)))
  :args ((= (= xb1 xb2) (= yb1 yb2)))
  :requires (((eo::to_z one) 1) ((eo::zmod (eo::to_z cx) 2) 1) ((eo::zmod (eo::to_z cy) 2) 1))
  :conclusion (= (= xb1 xb2) (= yb1 yb2))
)

;;;;; ProofRule::BV_ABSTRACTION

; define: $bv_is_zero
; args:
; - c (BitVec n): The term to check.
; return: True if c is the bit-vector value zero.
(define $bv_is_zero ((n Int :implicit) (c (BitVec n)))
  (eo::eq c (eo::to_bin ($bv_bitwidth (eo::typeof c)) 0)))

; define: $bv_is_one
; args:
; - c (BitVec n): The term to check.
; return: True if c is the bit-vector value one.
(define $bv_is_one ((n Int :implicit) (c (BitVec n)))
  (eo::eq c (eo::to_bin ($bv_bitwidth (eo::typeof c)) 1)))

; define: $bv_is_ones
; args:
; - c (BitVec n): The term to check.
; return: True if c is the bit-vector value in which all bits are one.
(define $bv_is_ones ((n Int :implicit) (c (BitVec n)))
  (eo::eq c ($bv_ones ($bv_bitwidth (eo::typeof c)))))

; define: $bv_abstraction_lemma_mul_cmp
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvmul that cannot be matched syntactically. This is the
;   case for the schemes that contain a variadic operator (bvand, bvor, bvxor,
;   bvadd, bvmul or concat), whose nil terminator depends on the bit-width and
;   thus is not a legal subterm of a pattern. We construct their instantiation
;   and compare instead.
(define $bv_abstraction_lemma_mul_cmp
  ((n Int :implicit) (x (BitVec n)) (s (BitVec n)) (t (BitVec n)) (l Bool))
  (eo::define ((w ($bv_bitwidth (eo::typeof x))))
  (eo::define ((zero (eo::to_bin w 0)))
  (eo::define ((one (eo::to_bin w 1)))
  (eo::define ((ones ($bv_ones w)))
  (eo::or
    ; MUL3_IC
    (eo::eq l (= (bvand (bvor (bvneg s) s) t) t))
    ; MUL4_ODD
    (eo::eq l (= (extract 0 0 t) (bvand (extract 0 0 x) (extract 0 0 s))))
    ; MUL5
    (eo::eq l (not (= s (bvnot (bvor t (bvand one (bvor x s)))))))
    ; MUL6
    (eo::eq l (not (= (bvand x t) (bvor s (bvnot t)))))
    ; MUL7
    (eo::eq l (not (= t (bvshl (bvor s one) (bvshl t x)))))
    ; MUL8
    (eo::eq l (= s (bvshl s (bvand x (bvlshr one t)))))
    ; MUL9
    (eo::eq l (bvuge t (bvand one (bvlshr (bvand x s) one))))
    ; MUL10
    (eo::eq l (not (= x (bvxor one (bvshl x (bvxor s t))))))
    ; MUL11
    (eo::eq l (not (= t (bvor one (bvnot (bvxor x s))))))
    ; MUL12
    (eo::eq l (not (= t (bvor (bvnot one) (bvxor x s)))))
    ; MUL13
    (eo::eq l (not (= x (bvsub (bvshl x (bvadd s t)) one))))
    ; MUL15
    (eo::eq l (not (= s (bvadd one (bvshl s (bvsub t x))))))
    ; MUL17
    (eo::eq l (not (= s (bvadd one (bvshl s (bvsub x t))))))
    ; MUL18
    (eo::eq l (not (= t (bvor one (bvadd x s)))))
    ; MUL19
    (eo::eq l (not (= x (bvnot (bvshl x (bvadd s t))))))
  ))))))

; program: $bv_abstraction_lemma_mul
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvmul. The cases below match the schemes whose
;   instantiation can be recognized syntactically, the last case handles the
;   remaining ones.
(program $bv_abstraction_lemma_mul
  ((n Int) (x (BitVec n)) (s (BitVec n)) (t (BitVec n))
   (c (BitVec n)) (d (BitVec n))
   (czero (BitVec n)) (cone (BitVec n)) (cones (BitVec n)) (l Bool))
  :signature ((BitVec n) (BitVec n) (BitVec n) Bool) Bool
  (
  ; MUL1_POW2: (=> (= x 2^i) (= t (bvshl s i)))
  (($bv_abstraction_lemma_mul x s t (=> (= x c) (= t (bvshl s d))))
      (eo::eq (eo::to_z c) ($arith_eval_int_pow_2 (eo::to_z d))))
  ; MUL2_NEG_POW2: (=> (= x -2^i) (= t (bvshl (bvneg s) i)))
  (($bv_abstraction_lemma_mul x s t (=> (= x c) (= t (bvshl (bvneg s) d))))
      (eo::eq (eo::to_z c)
              (eo::add ($arith_eval_int_pow_2 ($bv_bitwidth (eo::typeof x)))
                       (eo::neg ($arith_eval_int_pow_2 (eo::to_z d))))))
  ; MUL14
  (($bv_abstraction_lemma_mul x s t (not (= x (bvsub cone (bvshl x (bvsub s t))))))
      ($bv_is_one cone))
  ; MUL16
  (($bv_abstraction_lemma_mul x s t (not (= s (bvsub cone (bvshl s (bvsub t x))))))
      ($bv_is_one cone))
  (($bv_abstraction_lemma_mul x s t l) ($bv_abstraction_lemma_mul_cmp x s t l))
  )
)

; define: $bv_abstraction_lemma_udiv_cmp
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvudiv that cannot be matched syntactically. This is the
;   case for the schemes that contain a variadic operator (bvand, bvor, bvxor,
;   bvadd, bvmul or concat), whose nil terminator depends on the bit-width and
;   thus is not a legal subterm of a pattern. We construct their instantiation
;   and compare instead.
(define $bv_abstraction_lemma_udiv_cmp
  ((n Int :implicit) (x (BitVec n)) (s (BitVec n)) (t (BitVec n)) (l Bool))
  (eo::define ((w ($bv_bitwidth (eo::typeof x))))
  (eo::define ((zero (eo::to_bin w 0)))
  (eo::define ((one (eo::to_bin w 1)))
  (eo::define ((ones ($bv_ones w)))
  (eo::or
    ; UDIV7
    (eo::eq l (bvuge x (bvneg (bvand (bvneg s) (bvneg t)))))
    ; UDIV8
    (eo::eq l (bvuge (bvneg (bvor s one)) t))
    ; UDIV9
    (eo::eq l (not (= t (bvneg (bvand s (bvnot x))))))
    ; UDIV10
    (eo::eq l (not (= (bvor s t) (bvand x (bvnot one)))))
    ; UDIV11
    (eo::eq l (not (= (bvor s one) (bvand x (bvnot t)))))
    ; UDIV12
    (eo::eq l (bvuge (bvand x (bvneg t)) (bvand s t)))
    ; UDIV17
    (eo::eq l (bvuge x (bvand (bvor x t) (bvshl s one))))
    ; UDIV18
    (eo::eq l (bvuge x (bvand (bvor x s) (bvshl t one))))
    ; UDIV19
    (eo::eq l (not (= (bvlshr x t) (bvor s t))))
    ; UDIV21
    (eo::eq l (not (= x (bvnot (bvand x (bvshl t one))))))
    ; UDIV23
    (eo::eq l (bvuge x (bvshl s (bvnot (bvor x t)))))
    ; UDIV24
    (eo::eq l (bvuge x (bvshl t (bvnot (bvor x s)))))
    ; UDIV25
    (eo::eq l (bvuge x (bvxor t (bvlshr t (bvlshr s one)))))
    ; UDIV26
    (eo::eq l (bvuge x (bvxor s (bvlshr s (bvlshr t one)))))
    ; UDIV27
    (eo::eq l (bvuge x (bvshl s (bvnot (bvxor x t)))))
    ; UDIV28
    (eo::eq l (bvuge x (bvshl t (bvnot (bvxor x s)))))
    ; UDIV29
    (eo::eq l (not (= x (bvadd t (bvor s (bvadd x s))))))
    ; UDIV30
    (eo::eq l (not (= x (bvadd t (bvadd one (bvshl one x))))))
    ; UDIV31
    (eo::eq l (bvuge s (bvlshr (bvadd x t) t)))
    ; UDIV32
    (eo::eq l (not (= x (bvadd t (bvadd t (bvor x s))))))
    ; UDIV33
    (eo::eq l (bvuge (bvxor s (bvor x t)) (bvxor t one)))
  ))))))

; program: $bv_abstraction_lemma_udiv
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvudiv. The cases below match the schemes whose
;   instantiation can be recognized syntactically, the last case handles the
;   remaining ones.
(program $bv_abstraction_lemma_udiv
  ((n Int) (x (BitVec n)) (s (BitVec n)) (t (BitVec n))
   (c (BitVec n)) (d (BitVec n))
   (czero (BitVec n)) (cone (BitVec n)) (cones (BitVec n)) (l Bool))
  :signature ((BitVec n) (BitVec n) (BitVec n) Bool) Bool
  (
  ; UDIV1_POW2: (=> (= s 2^i) (= t (bvlshr x i)))
  (($bv_abstraction_lemma_udiv x s t (=> (= s c) (= t (bvlshr x d))))
      (eo::eq (eo::to_z c) ($arith_eval_int_pow_2 (eo::to_z d))))
  ; UDIV37
  (($bv_abstraction_lemma_udiv x s t (=> (= s cone) (= t x)))
      ($bv_is_one cone))
  ; UDIV2
  (($bv_abstraction_lemma_udiv x s t (=> (and (= s x) (not (= s czero))) (= t cone)))
      (eo::and ($bv_is_one cone) ($bv_is_zero czero)))
  ; UDIV3
  (($bv_abstraction_lemma_udiv x s t (=> (= s czero) (= t cones)))
      (eo::and ($bv_is_ones cones) ($bv_is_zero czero)))
  ; UDIV4
  (($bv_abstraction_lemma_udiv x s t (=> (and (= x czero) (not (= s czero))) (= t czero)))
      ($bv_is_zero czero))
  ; UDIV5
  (($bv_abstraction_lemma_udiv x s t (=> (not (= s czero)) (bvule t x)))
      ($bv_is_zero czero))
  ; UDIV6
  (($bv_abstraction_lemma_udiv x s t (=> (and (= s cones) (not (= x cones))) (= t czero)))
      (eo::and ($bv_is_ones cones) ($bv_is_zero czero)))
  ; UDIV13
  (($bv_abstraction_lemma_udiv x s t (bvuge s (bvlshr x t)))
      true)
  ; UDIV14
  (($bv_abstraction_lemma_udiv x s t (bvuge x (bvshl (bvlshr s (bvshl s t)) cone)))
      ($bv_is_one cone))
  ; UDIV15
  (($bv_abstraction_lemma_udiv x s t (bvuge x (bvlshr (bvshl t cone) (bvshl t s))))
      ($bv_is_one cone))
  ; UDIV16
  (($bv_abstraction_lemma_udiv x s t (bvuge t (bvshl (bvlshr x s) cone)))
      ($bv_is_one cone))
  ; UDIV20
  (($bv_abstraction_lemma_udiv x s t (not (= s (bvnot (bvlshr s (bvlshr t cone))))))
      ($bv_is_one cone))
  ; UDIV22
  (($bv_abstraction_lemma_udiv x s t (bvuge t (bvlshr (bvshl x cone) s)))
      ($bv_is_one cone))
  ; UDIV34
  (($bv_abstraction_lemma_udiv x s t (bvuge t (bvlshr x (bvsub s cone))))
      ($bv_is_one cone))
  ; UDIV35
  (($bv_abstraction_lemma_udiv x s t (bvuge (bvsub s cone) (bvlshr x t)))
      ($bv_is_one cone))
  ; UDIV36
  (($bv_abstraction_lemma_udiv x s t (not (= x (bvsub cone (bvshl x (bvsub x t))))))
      ($bv_is_one cone))
  (($bv_abstraction_lemma_udiv x s t l) ($bv_abstraction_lemma_udiv_cmp x s t l))
  )
)

; define: $bv_abstraction_lemma_urem_cmp
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvurem that cannot be matched syntactically. This is the
;   case for the schemes that contain a variadic operator (bvand, bvor, bvxor,
;   bvadd, bvmul or concat), whose nil terminator depends on the bit-width and
;   thus is not a legal subterm of a pattern. We construct their instantiation
;   and compare instead.
(define $bv_abstraction_lemma_urem_cmp
  ((n Int :implicit) (x (BitVec n)) (s (BitVec n)) (t (BitVec n)) (l Bool))
  (eo::define ((w ($bv_bitwidth (eo::typeof x))))
  (eo::define ((zero (eo::to_bin w 0)))
  (eo::define ((one (eo::to_bin w 1)))
  (eo::define ((ones ($bv_ones w)))
  (eo::or
    ; UREM1_POW2
    (eo::eq l (=> (= s one) (= t zero)))
    ; UREM8
    (eo::eq l (= x (bvand x (bvor s (bvor t (bvneg s))))))
    ; UREM9
    (eo::eq l (bvuge x (bvor t (bvand x s))))
    ; UREM10
    (eo::eq l (not (= one (bvand t (bvnot (bvor x s))))))
    ; UREM11
    (eo::eq l (not (= t (bvor (bvnot x) (bvneg s)))))
    ; UREM12
    (eo::eq l (bvuge (bvand t (bvor x s)) (bvand t one)))
    ; UREM13
    (eo::eq l (not (= x (bvor (bvneg x) (bvneg (bvnot t))))))
    ; UREM14
    (eo::eq l (bvuge (bvadd x (bvneg s)) t))
    ; UREM15
    (eo::eq l (bvuge (bvxor (bvneg s) (bvor x s)) t))
  ))))))

; program: $bv_abstraction_lemma_urem
; args:
; - x (BitVec n): The first operand of the abstracted term.
; - s (BitVec n): The second operand of the abstracted term.
; - t (BitVec n): The abstraction of the term.
; - l Bool: The formula to check.
; return: >
;   True if l is the instantiation for x, s and t of one of the refinement
;   lemma schemes for bvurem. The cases below match the schemes whose
;   instantiation can be recognized syntactically, the last case handles the
;   remaining ones.
(program $bv_abstraction_lemma_urem
  ((n Int) (x (BitVec n)) (s (BitVec n)) (t (BitVec n))
   (m Int) (h Int) (c (BitVec n)) (z (BitVec m))
   (czero (BitVec n)) (cone (BitVec n)) (cones (BitVec n)) (l Bool))
  :signature ((BitVec n) (BitVec n) (BitVec n) Bool) Bool
  (
  ; UREM1_POW2: (=> (= s 2^i) (= t (concat 0[w-i] x[i-1:0])))
  (($bv_abstraction_lemma_urem x s t (=> (= s c) (= t (concat z (extract h 0 x)))))
      (eo::and ($bv_is_zero z)
               (eo::eq (eo::to_z c) ($arith_eval_int_pow_2 (eo::add h 1)))))
  ; UREM2
  (($bv_abstraction_lemma_urem x s t (=> (not (= s czero)) (bvult t s)))
      ($bv_is_zero czero))
  ; UREM3
  (($bv_abstraction_lemma_urem x s t (=> (= x czero) (= t czero)))
      ($bv_is_zero czero))
  ; UREM4
  (($bv_abstraction_lemma_urem x s t (=> (= s czero) (= t x)))
      ($bv_is_zero czero))
  ; UREM5
  (($bv_abstraction_lemma_urem x s t (=> (= s x) (= t czero)))
      ($bv_is_zero czero))
  ; UREM6
  (($bv_abstraction_lemma_urem x s t (=> (bvult x s) (= t x)))
      true)
  (($bv_abstraction_lemma_urem x s t l) ($bv_abstraction_lemma_urem_cmp x s t l))
  )
)

; program: $bv_abstraction_lemma
; args:
; - l Bool: The formula to check.
; return: >
;   True if l is a bit-vector arithmetic abstraction lemma, i.e. if it has the
;   form (=> (= (op x s) t) lem) where op is one of bvmul, bvudiv and bvurem,
;   and lem is the instantiation for x, s and t of one of the refinement lemma
;   schemes of that operator.
(program $bv_abstraction_lemma
  ((n Int) (x (BitVec n)) (s (BitVec n)) (t (BitVec n)) (ns (BitVec n) :list) (l Bool))
  :signature (Bool) Bool
  (
  ; Note that bvmul is variadic in cvc5. The abstraction module only abstracts
  ; its binary applications, which we ensure by requiring that the tail ns of
  ; the multiplication is its nil terminator.
  (($bv_abstraction_lemma (=> (= (bvmul x s ns) t) l))
      (eo::requires (eo::to_z ns) 1 ($bv_abstraction_lemma_mul x s t l)))
  (($bv_abstraction_lemma (=> (= t (bvmul x s ns)) l))
      (eo::requires (eo::to_z ns) 1 ($bv_abstraction_lemma_mul x s t l)))
  (($bv_abstraction_lemma (=> (= (bvudiv x s) t) l)) ($bv_abstraction_lemma_udiv x s t l))
  (($bv_abstraction_lemma (=> (= t (bvudiv x s)) l)) ($bv_abstraction_lemma_udiv x s t l))
  (($bv_abstraction_lemma (=> (= (bvurem x s) t) l)) ($bv_abstraction_lemma_urem x s t l))
  (($bv_abstraction_lemma (=> (= t (bvurem x s)) l)) ($bv_abstraction_lemma_urem x s t l))
  )
)

; rule: bv_abstraction
; implements: ProofRule::BV_ABSTRACTION
; args:
; - F Bool: >
;   The abstraction lemma, of the form (=> (= (op x s) t) l) where op is one of
;   bvmul, bvudiv, bvurem and l is an instance of one of the refinement lemma
;   schemes of the bit-vector arithmetic abstraction module.
; requires: >
;   That F is an abstraction lemma in the above sense. Note that the antecedent
;   is required: the schemes constrain the abstraction t of (op x s) and are in
;   general not valid for an arbitrary t.
; conclusion: The given lemma.
(declare-rule bv_abstraction ((F Bool))
  :args (F)
  :requires ((($bv_abstraction_lemma F) true))
  :conclusion F
)
