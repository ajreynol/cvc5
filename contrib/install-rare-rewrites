#!/bin/bash
cvc5=cvc5
DIR=${CVC5_HOME}

# To be run in the build directory where cvc5 is built.

echo "[install-rare-rewrites] Generate cvc5 API include files..." 
make gen-rewrites
cp include/cvc5/cvc5_proof_rule.h $DIR/include/cvc5/cvc5_proof_rule.h

echo "[install-rare-rewrites] Install cvc5..."
make -j$(nproc)

echo "[install-rare-rewrites] Generate CPC Eunoia signature..."

REWRITE_SIG=$DIR/proofs/eo/cpc/rules/Rewrites.eo

cat << EOF > $REWRITE_SIG
(include "../theories/Builtin.eo")
(include "../theories/Arrays.eo")
(include "../theories/Arith.eo")
(include "../theories/ArithBvConv.eo")
(include "../theories/Reals.eo")
(include "../theories/BitVectors.eo")
(include "../theories/Strings.eo")
(include "../theories/Sets.eo")

EOF

echo "(check-sat)" | $cvc5 -o rare-db --force-logic=ALL --produce-proofs --proof-granularity=dsl-rewrite | sed '$ d' >> $REWRITE_SIG

# use eo::define instead of let
sed -i 's/(let/(eo::define/g' $REWRITE_SIG

echo "[install-rare-rewrites] Generate expert CPC Eunoia signature..."

EXPERT_REWRITE_SIG=$DIR/proofs/eo/cpc/expert/rules/RewritesExpert.eo

cat << EOF > $EXPERT_REWRITE_SIG
(include "../../theories/Reals.eo")

(include "../theories/SetsExt.eo")
(include "../theories/Transcendentals.eo")

EOF


echo "(check-sat)" | $cvc5 -o rare-db-expert --force-logic=ALL --produce-proofs --proof-granularity=dsl-rewrite | sed '$ d' >> $EXPERT_REWRITE_SIG

# use eo::define instead of let
sed -i 's/(let/(eo::define/g' $EXPERT_REWRITE_SIG

echo "[install-rare-rewrites] Generate executable rewrite implementation..."

# The implementation of the :exec rules. Only the body below is generated; it
# is substituted into rewrite_db_exec_template.cpp, which holds the parts that
# are written by hand. The result is checked in so that the build does not
# depend on a previously built cvc5.
EXEC_TEMPLATE=$DIR/src/rewriter/rewrite_db_exec_template.cpp
EXEC_IMPL=$DIR/src/rewriter/rewrite_db_exec.cpp
EXEC_BODY=$(mktemp)

echo "(check-sat)" | $cvc5 -o rare-db-exec --force-logic=ALL | sed '$ d' > $EXEC_BODY

python3 - "$EXEC_TEMPLATE" "$EXEC_BODY" "$EXEC_IMPL" << 'EOF'
import sys
template, body, out = sys.argv[1], sys.argv[2], sys.argv[3]
with open(template) as f:
    s = f.read()
with open(body) as f:
    b = f.read()
assert '${exec_impl}$' in s, 'template is missing the ${exec_impl}$ placeholder'
with open(out, 'w') as f:
    f.write(s.replace('${exec_impl}$', b.rstrip('\n')))
EOF

rm -f $EXEC_BODY

if grep -q "^// WARNING" $EXEC_IMPL; then
  echo "[install-rare-rewrites] WARNING: some :exec rules are incomplete or were"
  echo "[install-rare-rewrites] not compiled, see the notes in $EXEC_IMPL"
fi
